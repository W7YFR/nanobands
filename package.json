{
  "name": "nanobands",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Read a NanoVNA SWR sweep against the US band plan.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project pure --project dom",
    "test:watch": "vitest --project pure --project dom",
    "test:pure": "vitest run --project pure",
    "test:dom": "vitest run --project dom",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "bump": "node scripts/version.mjs --commit --branch \"$(git rev-parse --abbrev-ref HEAD)\"",
    "bump:dry": "node scripts/version.mjs --dry-run --branch \"$(git rev-parse --abbrev-ref HEAD)\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
