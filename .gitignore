# Build output. dist/ is the built site; `npm run build` regenerates it.
dist/

# Node
node_modules/
.vite/
*.tsbuildinfo

# Vitest's run output: failure screenshots and attachments, written fresh on
# every run that fails.
app/.vitest/
playwright-report/
test-results/
app/test/**/__screenshots__/

# Editor / OS cruft
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# Claude Code. Only the skills named here are shared; everything else in
# .claude/ is personal.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/changelog-check/
CLAUDE.local.md

# Local scratch: test photos, sweeps and exports made while working on it.
*.jpg
*.jpeg
*.heic
*.s1p
*.s2p
*.csv
swr-overlay*.png
swr-chart*.png

# ...except the photos the browser tier runs against. They are real photos of
# a NanoVNA-H4 and cannot be regenerated. See app/test/browser/photo.test.ts.
!app/test/data/*.jpg
